{
  "name": "agent-workspaces",
  "private": true,
  "scripts": {
    "check:worktree": "bash scripts/assert-clean-worktree.sh",
    "git:configure-main": "bash scripts/configure-canonical-main.sh",
    "git:new-worktree": "bash scripts/create-task-worktree.sh",
    "git:finish-worktree": "node scripts/git-finish-worktree.mjs",
    "git:check-finished-worktrees": "node scripts/git-finish-worktree.mjs --check",
    "git:push-main": "bash scripts/push-main.sh",
    "test:plugin-shell": "node tests/plugin-shell.test.mjs",
    "test:git-guard": "node --test scripts/git-finish-worktree.test.mjs && bash scripts/git-main-guard.test.sh"
  }
}
