            { "query": "42", "source": "knowledge-page-body", "previewText": "Migration wave 42" },
            { "query": "migration", "source": "knowledge-page-body", "previewText": "Migration wave 42" }
          ]
        },
        {
          "id": "exact-task",
          "type": "task",
          "title": "Prepare migration",
          "stableKey": "acme/mobile/42/task",
          "referenceValues": ["42", "#42"],
          "matches": [
            { "query": "42", "source": "task-number", "previewText": "#42" }
          ]
        }
