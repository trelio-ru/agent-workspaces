{
  "description": "Напоминает один раз назвать новую задачу Codex и проверяет закреплённую company policy модели и reasoning effort во всей работе с Trelio.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/trelio-runtime-policy.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/trelio-runtime-policy.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
